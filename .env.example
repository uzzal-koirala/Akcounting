# eSewa ePay v2 — sandbox test credentials (https://developer.esewa.com.np/pages/Test-credentials)
# Swap ESEWA_FORM_URL / ESEWA_STATUS_URL for the production hosts before going live.
ESEWA_PRODUCT_CODE="EPAYTEST"
