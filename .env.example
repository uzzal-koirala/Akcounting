ESEWA_STATUS_URL="https://rc.esewa.com.np/api/epay/transaction/status/"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenRouter — powers the AI assistant (server-side only, never exposed to the client)
OPENROUTER_API_KEY="replace-with-your-openrouter-api-key"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Cloudflare Turnstile — bot protection on the login form
NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-your-turnstile-site-key"
TURNSTILE_SECRET_KEY="replace-with-your-turnstile-secret-key"

# SMTP — sends admin-invite and password-set emails (e.g. Hostinger mailbox)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="replace-with-your-mailbox-address"
SMTP_PASSWORD="replace-with-your-mailbox-password"
SMTP_FROM="AKCounting <replace-with-your-mailbox-address>"
