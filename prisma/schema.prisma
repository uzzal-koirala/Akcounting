generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(cuid())
  name               String
  email              String            @unique
  phone              String?
  location           String            @default("")
  avatarUrl          String?           @db.LongText
  passwordHash       String
  role               String            @default("user")
  status             String            @default("Active")
  suspendReason      String            @default("") @db.Text
  failedLoginAttempts Int              @default(0)
  lockedAt           DateTime?
  calendarPreference String            @default("AD")
  businessCycleStartDay Int            @default(1)
  businessCycleEndDay Int              @default(31)
  plan               String            @default("Starter Package")
  planRenewsAt       DateTime?
  aiTokenBalance     Int               @default(50000)
  aiTokensUsed       Int               @default(0)
  passwordSetToken   String?           @unique
  passwordSetExpiresAt DateTime?
  emailVerifiedAt    DateTime?
  emailVerifyToken   String?           @unique
  emailVerifyExpiresAt DateTime?
  referralCode       String?           @unique
  referredByUserId   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  incomes            Income[]
  expenses           Expense[]
  salaries           Salary[]
  expenseCategories  ExpenseCategory[]
  documentCategories DocumentCategory[]
  documents          Document[]
  businessProfile    BusinessProfile?
  contacts           Contact[]
  invoices           Invoice[]
  supportTickets     SupportTicket[]
  payments           Payment[]
  loans              Loan[]
  loanPayments       LoanPayment[]
  products           Product[]
  notificationReads  NotificationRead[]
  subscriptionExtensions SubscriptionExtension[]
  teamMembers        TeamMember[]
  aiCreditOrders     AiCreditOrder[]
  dues               Due[]
}

model SubscriptionExtension {
  id        String   @id @default(cuid())
  userId    String
  days      Int      @default(3)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TeamMember {
  id                   String    @id @default(cuid())
  ownerId              String
  owner                User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                 String
  email                String    @unique
  role                 String    @default("Viewer")
  status               String    @default("Invited")
  passwordHash         String?
  passwordSetToken     String?   @unique
  passwordSetExpiresAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([ownerId])
}

model Plan {
  id              String   @id @default(cuid())
  name            String   @unique
  monthlyPrice    Int      @default(0)
  description     String   @default("")
  features        String   @db.Text
  maxTeamMembers  Int      @default(1)
  maxDocuments    Int      @default(0)
  canUploadImages Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model ReferralReward {
  id             String    @id @default(cuid())
  referrerId     String
  referredUserId String    @unique
  amount         Int
  paidOut        Boolean   @default(false)
  paidOutAt      DateTime?
  createdAt      DateTime  @default(now())
}

model AffiliateSettings {
  id           String   @id @default("default")
  rewardAmount Int      @default(500)
  minWithdrawal Int     @default(1000)
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model AffiliateWithdrawal {
  id             String    @id @default(cuid())
  userId         String
  amount         Int
  method         String    @default("Cash")
  status         String    @default("Pending")
  bankName       String    @default("")
  accountName    String    @default("")
  accountNumber  String    @default("")
  note           String    @default("") @db.Text
  adminNote      String    @default("") @db.Text
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  @@index([userId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String    @default("Percent")
  value          Int
  active         Boolean   @default(true)
  maxRedemptions Int?
  redemptions    Int       @default(0)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

model Notification {
  id        String             @id @default(cuid())
  title     String
  message   String             @db.Text
  type      String             @default("Info")
  audience  String             @default("All")
  createdAt DateTime           @default(now())
  reads     NotificationRead[]
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  read           Boolean      @default(false)
  dismissed      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

model Product {
  id           String   @id @default(cuid())
  userId       String
  name         String
  sku          String
  category     String
  type         String   @default("Product")
  description  String   @default("") @db.Text
  unit         String   @default("Piece")
  sellingPrice Decimal  @db.Decimal(12, 2)
  costPrice    Decimal  @default(0) @db.Decimal(12, 2)
  stock        Int      @default(0)
  reorderLevel Int      @default(5)
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sku])
  @@index([userId])
}

model Loan {
  id               String   @id @default(cuid())
  userId           String
  name             String
  lender           String
  principal        Decimal  @db.Decimal(12, 2)
  downPayment      Decimal  @default(0) @db.Decimal(12, 2)
  balance          Decimal  @db.Decimal(12, 2)
  rate             Decimal  @db.Decimal(5, 2)
  emiAmount        Decimal  @db.Decimal(12, 2)
  tenureMonths     Int
  paidInstallments Int      @default(0)
  startDate        DateTime @default(now())
  nextPaymentDate  DateTime
  status           String   @default("Active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments         LoanPayment[]

  @@index([userId])
}

model LoanPayment {
  id        String   @id @default(cuid())
  userId    String
  loanId    String
  loanName  String
  lender    String
  amount    Decimal  @db.Decimal(12, 2)
  paymentMethod String @default("Cash")
  proofUrl  String?  @db.LongText
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loanId])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  plan            String
  amount          Decimal  @db.Decimal(12, 2)
  transactionUuid String   @unique
  productCode     String
  status          String   @default("Pending")
  refId           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiCreditOrder {
  id              String   @id @default(cuid())
  userId          String
  credits         Int
  amount          Decimal  @db.Decimal(12, 2)
  transactionUuid String   @unique
  productCode     String
  status          String   @default("Pending")
  refId           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupportTicket {
  id        String        @id @default(cuid())
  userId    String
  subject   String
  category  String        @default("General")
  priority  String        @default("Medium")
  message   String        @db.Text
  imageUrl  String?       @db.LongText
  status    String        @default("Open")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   TicketReply[]

  @@index([userId])
}

model TicketReply {
  id         String       @id @default(cuid())
  ticketId   String
  authorName String
  isAdmin    Boolean      @default(false)
  message    String       @db.Text
  imageUrl   String?      @db.LongText
  createdAt  DateTime     @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model BusinessProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  legalName     String   @default("")
  tradingName   String   @default("")
  panVat        String   @default("")
  registration  String   @default("")
  invoicePrefix String   @default("INV")
  paymentTerms  String   @default("")
  email         String   @default("")
  phone         String   @default("")
  website       String   @default("")
  address       String   @default("")
  city          String   @default("")
  province      String   @default("")
  postalCode    String   @default("")
  country       String   @default("")
  bankName      String   @default("")
  accountName   String   @default("")
  accountNumber String   @default("")
  branch        String   @default("")
  swift         String   @default("")
  paymentMethod String   @default("Bank transfer")
  paymentNote   String   @default("") @db.Text
  logoUrl       String?  @db.LongText
  qrUrl         String?  @db.LongText
  signatureUrl  String?  @db.LongText
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id        String    @id @default(cuid())
  userId    String
  type      String
  name      String
  email     String    @default("")
  phone     String    @default("")
  address   String    @default("")
  panVat    String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  dues      Due[]

  @@index([userId])
}

model Due {
  id          String       @id @default(cuid())
  userId      String
  contactId   String
  title       String       @default("")
  totalAmount Int
  paidAmount  Int          @default(0)
  dueDate     DateTime?
  notes       String       @default("") @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  payments    DuePayment[]

  @@index([userId])
  @@index([contactId])
}

model DuePayment {
  id     String   @id @default(cuid())
  dueId  String
  amount Int
  note   String   @default("")
  paidAt DateTime @default(now())
  due    Due      @relation(fields: [dueId], references: [id], onDelete: Cascade)

  @@index([dueId])
}

model Invoice {
  id                  String        @id @default(cuid())
  userId              String
  contactId           String?
  number              String
  issueDate           DateTime
  dueDate             DateTime
  status              String        @default("Draft")
  docType             String        @default("Invoice")
  template            String        @default("bold")
  accentColor         String        @default("#dc2626")
  secondaryColor      String        @default("#202733")
  showPaymentInfo     Boolean       @default(true)
  footerMessage       String        @default("Thank you for your business! We truly appreciate your trust and support.") @db.Text
  iconColor           String        @default("#2563eb")
  descriptionFontSize Int           @default(11)
  taxRate             Decimal       @default(0) @db.Decimal(5, 2)
  discount            Decimal       @default(0) @db.Decimal(12, 2)
  notes               String        @default("") @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact             Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items               InvoiceItem[]

  @@index([userId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  rate        Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Income {
  id          String   @id @default(cuid())
  userId      String
  client      String
  description String
  source      String
  date        DateTime
  amount      Decimal  @db.Decimal(12, 2)
  status      String
  proofUrl    String?  @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  vendor      String
  description String
  category    String
  date        DateTime
  amount      Decimal  @db.Decimal(12, 2)
  status      String
  proofUrl    String?  @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Salary {
  id         String   @id @default(cuid())
  userId     String
  employee   String
  role       String
  month      String
  gross      Decimal  @db.Decimal(12, 2)
  deductions Decimal  @db.Decimal(12, 2)
  bonus      Decimal  @db.Decimal(12, 2)
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DocumentCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("bg-slate-400")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  name      String
  extension String
  sizeBytes Int
  category  String
  dataUrl   String   @db.LongText
  starred   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
